```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
.nuxt/
public/build/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/modules/
.DS_Store
*.swp
*~
.pytest_cache/
.mypy_cache/
.hypothesis/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
dist/
build/
*.min.js
*.min.css
coverage/
.nyc_output/
.npm
.yarn
package-lock.json
yarn.lock

# TypeScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map
*.tsx.map

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript output
*.tsbuildinfo
dist/
out/
build/

# Next.js
.next/
out/

# Nuxt.js
.nuxt/
dist/

# Vue.js
node_modules/
dist/
*.vuepress/dist

# React
build/
*.js.map
*.jsx.map

# General build artifacts
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
```